{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development build (Debug, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer build (Debug, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer build (Debug, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "dev-nixos",
      "inherits": "dev",
      "displayName": "NixOS development build (Debug, Ninja)",
      "binaryDir": "${sourceDir}/build-nixos"
    },
    {
      "name": "release-nixos",
      "displayName": "NixOS release build (Release, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-nixos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "release-test-nixos",
      "displayName": "NixOS release test build (Release, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-test-nixos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "asan-nixos",
      "inherits": "asan",
      "displayName": "NixOS AddressSanitizer build (Debug, Ninja)",
      "binaryDir": "${sourceDir}/build-asan-nixos"
    },
    {
      "name": "ubsan-nixos",
      "inherits": "ubsan",
      "displayName": "NixOS UndefinedBehaviorSanitizer build (Debug, Ninja)",
      "binaryDir": "${sourceDir}/build-ubsan-nixos"
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "dev-nixos", "configurePreset": "dev-nixos" },
    { "name": "release-nixos", "configurePreset": "release-nixos" },
    { "name": "release-test-nixos", "configurePreset": "release-test-nixos" },
    { "name": "asan-nixos", "configurePreset": "asan-nixos" },
    { "name": "ubsan-nixos", "configurePreset": "ubsan-nixos" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    {
      "name": "asan",
      "configurePreset": "asan",
      "environment": { "ASAN_OPTIONS": "detect_leaks=0" },
      "output": { "outputOnFailure": true }
    },
    { "name": "ubsan", "configurePreset": "ubsan", "output": { "outputOnFailure": true } },
    {
      "name": "dev-nixos",
      "configurePreset": "dev-nixos",
      "environment": {
        "__EGL_VENDOR_LIBRARY_FILENAMES": "$penv{SCALPEL_TEST_EGL_VENDOR_LIBRARY_FILENAMES}",
        "LIBGL_DRIVERS_PATH": "$penv{SCALPEL_TEST_LIBGL_DRIVERS_PATH}"
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-test-nixos",
      "configurePreset": "release-test-nixos",
      "environment": {
        "__EGL_VENDOR_LIBRARY_FILENAMES": "$penv{SCALPEL_TEST_EGL_VENDOR_LIBRARY_FILENAMES}",
        "LIBGL_DRIVERS_PATH": "$penv{SCALPEL_TEST_LIBGL_DRIVERS_PATH}"
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan-nixos",
      "configurePreset": "asan-nixos",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "__EGL_VENDOR_LIBRARY_FILENAMES": "$penv{SCALPEL_TEST_EGL_VENDOR_LIBRARY_FILENAMES}",
        "LIBGL_DRIVERS_PATH": "$penv{SCALPEL_TEST_LIBGL_DRIVERS_PATH}"
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ubsan-nixos",
      "configurePreset": "ubsan-nixos",
      "environment": {
        "__EGL_VENDOR_LIBRARY_FILENAMES": "$penv{SCALPEL_TEST_EGL_VENDOR_LIBRARY_FILENAMES}",
        "LIBGL_DRIVERS_PATH": "$penv{SCALPEL_TEST_LIBGL_DRIVERS_PATH}"
      },
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "ubsan",
      "steps": [
        { "type": "configure", "name": "ubsan" },
        { "type": "build", "name": "ubsan" },
        { "type": "test", "name": "ubsan" }
      ]
    },
    {
      "name": "dev-nixos",
      "steps": [
        { "type": "configure", "name": "dev-nixos" },
        { "type": "build", "name": "dev-nixos" },
        { "type": "test", "name": "dev-nixos" }
      ]
    },
    {
      "name": "release-nixos",
      "steps": [
        { "type": "configure", "name": "release-nixos" },
        { "type": "build", "name": "release-nixos" }
      ]
    },
    {
      "name": "release-test-nixos",
      "steps": [
        { "type": "configure", "name": "release-test-nixos" },
        { "type": "build", "name": "release-test-nixos" },
        { "type": "test", "name": "release-test-nixos" }
      ]
    },
    {
      "name": "asan-nixos",
      "steps": [
        { "type": "configure", "name": "asan-nixos" },
        { "type": "build", "name": "asan-nixos" },
        { "type": "test", "name": "asan-nixos" }
      ]
    },
    {
      "name": "ubsan-nixos",
      "steps": [
        { "type": "configure", "name": "ubsan-nixos" },
        { "type": "build", "name": "ubsan-nixos" },
        { "type": "test", "name": "ubsan-nixos" }
      ]
    }
  ]
}
