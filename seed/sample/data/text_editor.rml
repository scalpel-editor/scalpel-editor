<rml>
<head>
	<title>Text Editor</title>
	<link type="text/rcss" href="/assets/rml.rcss"/>
	<style>
		/* The base palette is the Light theme (the default). The dark values live in the
		   "body.theme-dark" overrides at the end; the app toggles that class from the View menu. */
		body {
			width: 100%;
			height: 100%;
			margin: 0;
			font-family: system-ui;
			font-size: 15px;
			color: #1d2026;
			background-color: #f4f5f7;
		}

		#app {
			display: flex;
			flex-direction: column;
			width: 100%;
			height: 100%;
		}

		#toolbar {
			display: flex;
			align-items: center;
			gap: 8px;
			padding: 4px;
			background-color: #e6e8ec;
			border-bottom: 1px #c8cdd6;
		}

		button {
			height: 16px;
			padding: 5px 10px;
			color: #1d2026;
			background-color: #dfe3e9;
			border: 1px #b6bdc9;
		}

		button:hover {
			background-color: #d0d6de;
		}

		button:active {
			background-color: #c2c9d3;
		}

		/* The menubar blends into the toolbar; the default menu structure/behavior
		   comes from assets/rml.rcss, these rules just theme it for the editor. */
		#menu {
			background-color: transparent;
			color: #1d2026;
		}

		#menu menulabel {
			padding: 2px 12px;
		}

		#menu menulabel:hover {
			background-color: #d0d6de;
		}

		#menu menu:open > menulabel {
			background-color: #dfe3e9;
			color: #000000;
		}

		#menu menupopup {
			min-width: 170px;
			padding: 4px 0;
			background-color: #ffffff;
			border: 1px #b6bdc9;
		}

		#menu menuitem {
			padding: 6px 24px 6px 12px;
		}

		#menu menuitem:hover {
			background-color: #d0d6de;
			color: #000000;
		}

		#menu menuseparator {
			margin: 4px 0;
			background-color: #c8cdd6;
		}

		/* Active menu indicator. The dot reserves its space even when hidden so checked groups
		   stay aligned; only the checked item shows the dot and a bold label. */
		#menu .tick {
			display: inline-block;
			width: 7px;
			height: 7px;
			margin-right: 8px;
			background-color: transparent;
		}

		#menu menuitem.active .tick {
			background-color: #3a6ea5;
		}

		#menu menuitem.active {
			font-weight: bold;
		}

		#tabs {
			display: flex;
			gap: 4px;
			padding: 7px 8px 0 8px;
			background-color: #eaecef;
			border-bottom: 1px #c8cdd6;
		}

		.tab-item {
			display: flex;
			align-items: center;
			height: 30px;
			margin-right: 2px;
			background-color: #dde1e7;
			border: 1px #c1c8d2;
		}

		.tab-button {
			box-sizing: border-box;
			height: 30px;
			min-width: 92px;
			padding: 5px 8px 5px 10px;
			background-color: transparent;
			border: 0px;
		}

		.tab-item.selected {
			background-color: #b9c6db;
			border-color: #8ea0be;
		}

		.tab-item.dirty .tab-button {
			color: #9a6b00;
		}

		.tab-close {
			box-sizing: border-box;
			width: 26px;
			height: 30px;
			padding: 0;
			text-align: center;
			background-color: transparent;
			border: 0px;
		}

		#editor_wrap {
			flex: 1;
			min-height: 0;
			padding: 10px;
			background-color: #f4f5f7;
		}

		#editor {
			box-sizing: border-box;
			width: 100%;
			height: 100%;
			overflow: hidden;
			/* Scintilla paints the content box; CSS padding was a leftover from the textarea and
			   left a non-scrolling strip above the first line that also ate mouse hits. */
			padding: 0;
			font-family: monospace;
			font-size: 16px;
			line-height: 1.45;
			color: #1a1c22;
			background-color: #f5f5f5;
			caret-color: #000000;
			border: 1px #b6bdc9;
		}

		#editor:focus-visible {
			border-color: #6b7f9e;
		}

		#editor scrollbarvertical {
			width: 14px;
			background-color: #e3e6eb;
			border-left: 1px #c4cad3;
		}

		#editor scrollbarvertical slidertrack {
			background-color: #e3e6eb;
		}

		#editor scrollbarvertical sliderbar {
			width: 13px;
			min-height: 28px;
			background-color: #aeb6c2;
		}

		#editor scrollbarhorizontal {
			height: 14px;
			background-color: #e3e6eb;
			border-top: 1px #c4cad3;
		}

		#editor scrollbarhorizontal slidertrack {
			background-color: #e3e6eb;
		}

		#editor scrollbarhorizontal sliderbar {
			height: 13px;
			min-width: 28px;
			background-color: #aeb6c2;
		}

		#editor scrollbarvertical sliderbar:hover,
		#editor scrollbarhorizontal sliderbar:hover {
			background-color: #8c96a5;
		}

		#editor scrollbarvertical sliderbar:active,
		#editor scrollbarhorizontal sliderbar:active {
			background-color: #6f7b8d;
		}

		#status {
			height: 26px;
			padding: 5px 10px;
			color: #565f6d;
			background-color: #eaecef;
			border-top: 1px #c8cdd6;
		}

		/* Close-confirmation modal. Hidden until the app requests it via the "visible" class when the
		   compositor asks the window to close and there is unsaved work. */
		#close_confirm {
			display: none;
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			align-items: center;
			justify-content: center;
			background-color: rgba(0, 0, 0, 120);
		}

		#close_confirm.visible {
			display: flex;
		}

		#close_confirm .dialog {
			display: flex;
			flex-direction: column;
			width: 420px;
			padding: 18px;
			background-color: #ffffff;
			border: 1px #b6bdc9;
		}

		#close_confirm .dialog-title {
			margin-bottom: 8px;
			font-size: 18px;
			color: #1d2026;
		}

		#close_confirm .dialog-message {
			margin-bottom: 16px;
			color: #3a4250;
		}

		#close_confirm .dialog-actions {
			display: flex;
			justify-content: flex-end;
			gap: 8px;
		}

		#close_confirm .discard {
			background-color: #f2d6d8;
			border-color: #d99aa0;
		}

		#close_confirm .discard:hover {
			background-color: #ecc6c9;
		}

		#close_confirm .save {
			background-color: #d6ecdc;
			border-color: #9ad0a8;
		}

		#close_confirm .save:hover {
			background-color: #c6e4cf;
		}

		/* Dark theme. Active while the app puts the "theme-dark" class on the body; these rules
		   override only the colors set by the Light base above. */
		body.theme-dark {
			color: #e8e8e8;
			background-color: #1d2026;
		}

		body.theme-dark #toolbar {
			background-color: #2a2f38;
			border-bottom-color: #414958;
		}

		body.theme-dark button {
			color: #f2f2f2;
			background-color: #38404c;
			border-color: #566174;
		}

		body.theme-dark button:hover {
			background-color: #465264;
		}

		body.theme-dark button:active {
			background-color: #2f3744;
		}

		body.theme-dark #menu {
			color: #e8e8e8;
		}

		body.theme-dark #menu menulabel:hover {
			background-color: #465264;
		}

		body.theme-dark #menu menu:open > menulabel {
			background-color: #38404c;
			color: #ffffff;
		}

		body.theme-dark #menu menupopup {
			background-color: #2a2f38;
			border-color: #566174;
		}

		body.theme-dark #menu menuitem:hover {
			background-color: #465264;
			color: #ffffff;
		}

		body.theme-dark #menu menuseparator {
			background-color: #414958;
		}

		body.theme-dark #menu menuitem.active .tick {
			background-color: #ffd27a;
		}

		body.theme-dark #tabs {
			background-color: #242932;
			border-bottom-color: #414958;
		}

		body.theme-dark .tab-item {
			background-color: #303743;
			border-color: #485263;
		}

		body.theme-dark .tab-item.selected {
			background-color: #52627a;
			border-color: #7c8fac;
		}

		body.theme-dark .tab-item.dirty .tab-button {
			color: #ffd27a;
		}

		body.theme-dark #editor_wrap {
			background-color: #1d2026;
		}

		body.theme-dark #editor {
			color: #f4f4f4;
			background-color: #15181e;
			caret-color: #ffffff;
			border-color: #4a5363;
		}

		body.theme-dark #editor:focus-visible {
			border-color: #7c8fac;
		}

		body.theme-dark #editor scrollbarvertical,
		body.theme-dark #editor scrollbarhorizontal,
		body.theme-dark #editor scrollbarvertical slidertrack,
		body.theme-dark #editor scrollbarhorizontal slidertrack {
			background-color: #252a33;
			border-color: #414958;
		}

		body.theme-dark #editor scrollbarvertical sliderbar,
		body.theme-dark #editor scrollbarhorizontal sliderbar {
			background-color: #596476;
		}

		body.theme-dark #editor scrollbarvertical sliderbar:hover,
		body.theme-dark #editor scrollbarhorizontal sliderbar:hover {
			background-color: #748197;
		}

		body.theme-dark #editor scrollbarvertical sliderbar:active,
		body.theme-dark #editor scrollbarhorizontal sliderbar:active {
			background-color: #91a0b8;
		}

		body.theme-dark #status {
			color: #bbc3d0;
			background-color: #242932;
			border-top-color: #414958;
		}

		body.theme-dark #close_confirm {
			background-color: rgba(0, 0, 0, 180);
		}

		body.theme-dark #close_confirm .dialog {
			background-color: #2a2f38;
			border-color: #566174;
		}

		body.theme-dark #close_confirm .dialog-title {
			color: #ffffff;
		}

		body.theme-dark #close_confirm .dialog-message {
			color: #cbd3e0;
		}

		body.theme-dark #close_confirm .discard {
			background-color: #5a2f33;
			border-color: #8a4a50;
		}

		body.theme-dark #close_confirm .discard:hover {
			background-color: #6d383d;
		}

		body.theme-dark #close_confirm .save {
			background-color: #2f5a3a;
			border-color: #4a8a5c;
		}

		body.theme-dark #close_confirm .save:hover {
			background-color: #386d47;
		}
	</style>
</head>
<body>
	<div id="app">
		<div id="toolbar">
			<menubar id="menu">
				<menu label="File">
					<menuitem onmenuitemselect="new_document">New</menuitem>
					<menuitem onmenuitemselect="open_document">Open</menuitem>
					<menuseparator/>
					<menuitem onmenuitemselect="save_document">Save</menuitem>
					<menuitem onmenuitemselect="save_as_document">Save As</menuitem>
					<menuseparator/>
					<menuitem onmenuitemselect="close_document">Close</menuitem>
					<menuitem onmenuitemselect="discard_document">Discard</menuitem>
				</menu>
				<menu label="View">
					<menuitem id="theme_light_item" onmenuitemselect="theme_light"><span class="tick"></span>Light</menuitem>
					<menuitem id="theme_dark_item" onmenuitemselect="theme_dark"><span class="tick"></span>Dark</menuitem>
					<menuseparator/>
					<menuitem id="word_wrap_item" onmenuitemselect="toggle_word_wrap"><span class="tick"></span>Word Wrap</menuitem>
				</menu>
				<menu label="Font">
					<menuitem id="font_system_ui_item" onmenuitemselect="font_system_ui"><span class="tick"></span>system-ui</menuitem>
					<menuitem id="font_sans_serif_item" onmenuitemselect="font_sans_serif"><span class="tick"></span>sans-serif</menuitem>
					<menuitem id="font_serif_item" onmenuitemselect="font_serif"><span class="tick"></span>serif</menuitem>
					<menuitem id="font_monospace_item" onmenuitemselect="font_monospace"><span class="tick"></span>monospace</menuitem>
				</menu>
			</menubar>
		</div>
		<div id="tabs">
			<div class="tab-item selected">
				<button class="tab-button">Untitled</button>
				<button class="tab-close">x</button>
			</div>
		</div>
		<div id="editor_wrap">
			<scintilla id="editor" autofocus></scintilla>
		</div>
		<div id="status">Ready</div>
	</div>
	<div id="close_confirm">
		<div class="dialog">
			<div class="dialog-title">Unsaved changes</div>
			<div class="dialog-message">You have unsaved changes. Save them before closing?</div>
			<div class="dialog-actions">
				<button class="save" onclick="confirm_close_save">Save all</button>
				<button class="discard" onclick="confirm_close_discard">Discard</button>
				<button onclick="confirm_close_cancel">Cancel</button>
			</div>
		</div>
	</div>
</body>
</rml>
